# --- core ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://mfi:mfi@localhost:5432/mfi
REDIS_URL=redis://localhost:6379/0
USE_TIMESCALE=true
CORS_ORIGINS=http://localhost:3000
# Set to require "Authorization: Bearer <token>" on every API call (recommended once deployed)
API_TOKEN=
# Run re-analysis inside the request (simple). Set false to hand it to the Celery worker.
RECOMPUTE_INLINE=true

# --- uploads ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20
# Optional S3-compatible storage for original uploads
S3_BUCKET=
S3_ENDPOINT_URL=
# Optional ClamAV malware scanning (host:port)
CLAMD_HOST=

# --- AI (LLM abstraction layer): none | anthropic | openai ---
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free option: LLM_PROVIDER=gemini and a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- data providers (all optional; manual input always works) ---
FRED_API_KEY=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# --- verification ---
VERIFICATION_RETRY_MINUTES=30
VERIFICATION_TOLERANCE=0.05
